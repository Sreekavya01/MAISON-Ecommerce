# Public storefront origin used by feedback email links.
# The function falls back to https://<firebase-project-id>.web.app when omitted.
MAISON_SITE_URL=https://your-maison-domain.example

# EMAIL_SERVICE_TOKEN is a Firebase Functions secret, not a dotenv value.
# Configure it with:
# npx firebase functions:secrets:set EMAIL_SERVICE_TOKEN
# It must exactly match the Cloudflare Worker secret of the same name.
